post_install() {
    # 更新图标缓存
    gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null

    # 更新桌面数据库
    update-desktop-database -q /usr/share/applications 2>/dev/null

    echo ""
    echo "Wallhaven 已成功安装！"
    echo ""
    echo "使用方式："
    echo "  - 从应用菜单启动 'Wallhaven'"
    echo "  - 或运行命令: wallhaven"
    echo ""
    echo "首次使用需要配置 Wallhaven API Key 以访问完整功能。"
    echo ""
}

post_upgrade() {
    post_install
}

post_remove() {
    # 更新图标缓存
    gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null

    # 更新桌面数据库
    update-desktop-database -q /usr/share/applications 2>/dev/null

    echo "Wallhaven 已卸载。"
    echo "您的配置文件和下载的壁纸仍保存在 ~/.config/wallhaven/"
}
