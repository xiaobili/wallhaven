# Maintainer: BillyJR <your-email@example.com>
# Contributor: BillyJR <your-email@example.com>

pkgname=wallhaven-app
pkgver=2.7.0
pkgrel=1
pkgdesc="一款优雅的跨平台桌面壁纸浏览与下载应用 - Wallhaven wallpaper browser and downloader"
arch=('x86_64')
url="https://github.com/BillyJR/wallhaven"
license=('MIT')
depends=(
    'electron'
    'gtk3'
    'libnotify'
    'libsecret'
    'libxtst'
    'nss'
    'alsa-lib'
    'libcups'
    'libxss'
    'nspr'
    'at-spi2-core'
)
makedepends=(
    'npm'
    'nodejs>=20'
    'git'
)
optdepends=(
    'libappindicator-gtk3: System tray support'
)
provides=('wallhaven')
conflicts=('wallhaven')
source=(
    "${pkgname}-${pkgver}.tar.gz::https://github.com/BillyJR/wallhaven/archive/refs/tags/v${pkgver}.tar.gz"
    "wallhaven.desktop"
    "wallhaven.install"
)
sha256sums=('SKIP'  # 需要在发布时更新为实际的校验和
            'SKIP'
            'SKIP')

build() {
    cd "${srcdir}/wallhaven-${pkgver}"

    # 安装依赖
    npm install --cache="${srcdir}/npm-cache"

    # 构建应用
    npm run build

    # 仅构建 Linux AppImage 资源
    npx electron-builder --linux dir --x64 --config
}

package() {
    cd "${srcdir}/wallhaven-${pkgver}"

    # 创建应用目录
    install -d "${pkgdir}/opt/wallhaven"

    # 复制构建产物
    cp -r out/* "${pkgdir}/opt/wallhaven/"

    # 创建可执行文件
    install -d "${pkgdir}/usr/bin"
    cat > "${pkgdir}/usr/bin/wallhaven" << EOF
#!/bin/bash
exec electron /opt/wallhaven "\$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/wallhaven"

    # 安装桌面文件
    install -d "${pkgdir}/usr/share/applications"
    install -Dm644 "${srcdir}/wallhaven.desktop" "${pkgdir}/usr/share/applications/"

    # 安装图标
    for size in 16 32 48 64 128 256 512; do
        install -d "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps"
        if [ -f "build/icons/${size}x${size}.png" ]; then
            install -Dm644 "build/icons/${size}x${size}.png" \
                "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/wallhaven.png"
        fi
    done

    # 安装许可证
    install -d "${pkgdir}/usr/share/licenses/${pkgname}"
    if [ -f "LICENSE" ]; then
        install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/"
    fi

    # 安装文档
    install -d "${pkgdir}/usr/share/doc/${pkgname}"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/"
}
